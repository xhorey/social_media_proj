Table project.users{
  id serial [pk]
  username varchar(30) [not null, unique]
  fullName varchar(255) [not null]
  password varchar(255) [not null]
  email varchar(255) [unique, not null]
}

Table project.games{
  gameId serial [pk]
  gameName varchar(255) [not null]
}

Table project.game_players {
  gameId int [not null, ref: > project.games.gameId]
  playerId int [not null, ref: > project.users.id]
  playerScore int [not null]
  placement int [not null]
  playTimes timestamp [default: 'now()']
  primary key(gameId, playerId)
}

table project.stats{
  playerId int [ pk , ref: - project.users.id]
  totalWins int
  games_played int
  win_percentage int
}

table project.player_achievements{
  playerId int [not null, ref: > project.users.id]
  Achievement_Id int [not null, ref: > project.achievements.Achievement_Id]
  achieveDate date [default: 'now()']
  primary key(Achievement_Id, playerId)
}

table project.achievements{
  Achievement_Id serial [pk]
  AchievementName varchar(255) unique
  description varchar(255)
  gameId int [ref: > project.games.gameId]
}